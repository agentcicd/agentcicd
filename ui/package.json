{
  "name": "@agentcicd/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "npm run build:library && npm run build:viewer",
    "build:library": "tsc --project tsconfig.build.json && vite build --config vite.library.config.ts",
    "build:viewer": "vite build --config vite.viewer.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "^12.10.0",
    "clsx": "2.1.1",
    "dagre": "^0.8.5",
    "lucide-react": "0.487.0",
    "monaco-editor": "^0.52.2",
    "recharts": "2.15.2",
    "tailwind-merge": "3.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@testing-library/react": "^16.3.0",
    "@types/dagre": "^0.7.53",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "4.1.12",
    "typescript": "^5.7.2",
    "vite": "6.3.5",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
